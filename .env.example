# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (a project dedicated to ai-audit-pipeline — do not reuse another project's)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI provider for the audit brain: anthropic (production, Claude Opus) | groq | mistral (testing only)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Bright Data (research)
BRIGHTDATA_API_KEY=

# Email service (e.g. Resend) for the client estimate PDF + founder lead email
RESEND_API_KEY=
FOUNDER_LEAD_EMAIL=

# Discovery call scheduling link (e.g. Cal.com/Calendly)
DISCOVERY_CALL_BOOKING_URL=
